  {
    "id": "fnSplit",
    "type": "function",
    "z": "tab1",
    "name": "Split telemetry",
    "func": "const d = msg.payload;\nif (typeof d !== 'object' || d === null) return null;\nconst warn = (d.temp_ok === false) ? ' ⚠️ [Nước chưa đạt 88-94°C]' : ' ✅ [Nhiệt độ chuẩn]';\nreturn [\n  { payload: d.weight_g, topic: 'Khối lượng (g)' },\n  { payload: d.flow_rate_gps, topic: 'Lưu lượng (g/s)' },\n  { payload: (typeof d.water_temp_c === 'number') ? d.water_temp_c : 0 },\n  { payload: (d.state || 'IDLE') + ' | ' + (d.recipe || '') + ' | ' + (d.elapsed_s || 0) + 's' },\n  { payload: (d.message || '') + warn }\n];",
    "outputs": 5,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 310,
    "y": 100,
    "wires": [
      [
