  {
    "id": "fnStart",
    "type": "function",
    "z": "tab1",
    "name": "Build START_BREW",
    "func": "const r = flow.get(\"selected_recipe\") || \"Classic_PourOver\";\nlet cmd = { action: \"START_BREW\", recipe_name: r, coffee_dose_g: 15.0, ratio: 15.0, bloom_water_g: 30.0, bloom_time_s: 35 };\nif (r === \"Vietnamese_Phin\") {\n  cmd = { action: \"START_BREW\", recipe_name: \"Vietnamese_Phin\", coffee_dose_g: 20.0, ratio: 10.0, bloom_water_g: 40.0, bloom_time_s: 35 };\n} else if (r === \"Night_Shift\") {\n  cmd = { action: \"START_BREW\", recipe_name: \"Night_Shift\", coffee_dose_g: 18.0, ratio: 12.0, bloom_water_g: 36.0, bloom_time_s: 40 };\n}\nreturn { payload: cmd };",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 370,
    "y": 320,
    "wires": [
